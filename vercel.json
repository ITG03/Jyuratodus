{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "vercel/api/**/*.js", "use": "@vercel/node" }
  ],
  "functions": {
    "api/**/*.js": { "runtime": "nodejs20.x" },
    "vercel/api/**/*.js": { "runtime": "nodejs20.x" }
  },
  "routes": [
    { "src": "/api/analytics/(.*)", "dest": "api/analytics/$1.js" },
    { "src": "/api/records/(.*)", "dest": "api/records/$1.js" },
    { "src": "/api/refs/people/(.*)", "dest": "api/refs/people/$1.js" },
    { "src": "/api/refs/(.*)", "dest": "api/refs/$1.js" },
    { "src": "/api/(.*)", "dest": "api/$1.js" }
  ]
}